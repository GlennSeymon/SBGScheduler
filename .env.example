# Copy to .env.local and fill in real values (never commit .env.local).
# `vercel env pull` will overwrite .env.local with the values set in the Vercel project.

# Required — Postgres connection string (Neon). Use the pooled connection string;
# provisioned automatically via the Vercel Marketplace Neon integration.
DATABASE_URL=

# Required for Prisma Migrate/seed only — Neon's direct (non-pooled) connection string.
# Pgbouncer's pooled connection doesn't support the advisory locks Prisma Migrate needs.
# Also provisioned automatically via the Vercel Marketplace Neon integration.
DATABASE_URL_UNPOOLED=

# Optional — port the backend Express server listens on locally (default: 3001).
PORT=3001

# Weather + geocoding (Open-Meteo) need no API key, so no vars are required for them.

# Optional — Sentry error tracking (Phase 12). Provisioned automatically via the Vercel
# Marketplace Sentry integration; one shared project covers both frontend and backend.
# SENTRY_DSN is for the backend (process.env); VITE_SENTRY_DSN is the same DSN exposed to
# the frontend build (Vite only bundles VITE_-prefixed vars). A Sentry DSN is a public
# write-only key by design, safe to ship in the client bundle.
SENTRY_DSN=
VITE_SENTRY_DSN=
