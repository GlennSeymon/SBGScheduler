{
  "name": "sbg-scheduler",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n shared,backend,frontend -c yellow,green,blue \"npm run dev --workspace=shared\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "vercel deploy --prod --scope glennseymons-projects",
    "deploy:preview": "vercel deploy --scope glennseymons-projects"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
