# Dependencies
node_modules/

# Env / secrets
.env
.env.*
!.env.example

# Internal planning docs — kept locally, not shipped in the interview deliverable
# (README.md and clientBrief.md stay tracked)
/CLAUDE.md
/projectScope.md
/tech-stack.md
/implementation-plan.md

# Build output
dist/
# Exception: backend/dist/{index.js,package.json} are committed as placeholders so Vercel's
# Services entrypoint check (which runs against the fresh git clone, before buildCommand) finds
# something there. buildCommand overwrites them with the real build on every deploy.
!backend/dist/
backend/dist/*
!backend/dist/index.js
!backend/dist/package.json
build/
.vercel/
*.tsbuildinfo

# Prisma
**/generated/

# Testing
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Sentry
.sentryclirc
.env.sentry-build-plugin

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local scaffolding
.claude/
.agents/

